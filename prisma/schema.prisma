// prisma/schema.prisma
// PillMind Üretim Sürümü - Prisma Veritabanı Şeması

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Supabase için doğrudan bağlantı (opsiyonel)
}

generator client {
  provider = "prisma-client-js"
}

enum Severity {
  HIGH     // Yüksek / Potansiyel Önemli Etkileşim
  MEDIUM   // Orta / Dikkat Edilmesi Gereken Etkileşim
  LOW      // Düşük / Olası Hafif Etkileşim
}

enum Status {
  PENDING
  VERIFIED
  DEPRECATED
}

enum EvidenceLevel {
  FDA_APPROVED
  CLINICAL_GUIDELINE
  PUBMED_CASE
  OBSERVATIONAL
}

model Drug {
  id               String            @id @default(uuid())
  rxcui            String?           @unique // RxNorm Benzersiz Kodu (Opsiyonel)
  name             String            @unique // İlaç Ticari Marka Adı (Örn: Coumadin)
  activeIngredient String            // Aktif Etken Madde (Örn: Warfarin Sodyum)
  category         String            // İlaç Sınıfı (Örn: Antikoagülan)
  description      String?           @db.Text
  status           Status            @default(VERIFIED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  pharmacologicalGroup String?       // Farmakolojik Sınıf/Grup (Örn: NSAID, Beta Bloker)
  ingredientId     String?
  drugClassId      String?
  
  // İlişkiler
  brandNames       BrandName[]
  interactions1    DrugInteraction[] @relation("Drug1Relation")
  interactions2    DrugInteraction[] @relation("Drug2Relation")
  foodInteractions FoodInteraction[]
  contraindications Contraindication[]
  ingredient       Ingredient?       @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  drugClass        DrugClass?        @relation(fields: [drugClassId], references: [id], onDelete: SetNull)
  aliases          DrugAlias[]

  @@index([activeIngredient])
  @@index([ingredientId])
  @@index([drugClassId])
}

model BrandName {
  id        String   @id @default(uuid())
  name      String   @unique // Alternatif Ticari Marka Adı (Örn: Coraspin, Aspirin)
  drugId    String
  drug      Drug     @relation(fields: [drugId], references: [id], onDelete: Cascade)
  
  @@index([name])
}

model DrugInteraction {
  id                 String   @id @default(uuid())
  drug1Id            String
  drug2Id            String
  severity           Severity
  summary            String   @db.Text // Sade Türkçe tıbbi özet
  clinicalDetail     String?  @db.Text // Hekimler ve eczacılar için klinik detay (Türkçe)
  source             String   // Bilimsel kaynak referansı (Örn: FDA Label, PubMed)
  sourceLabel        String   // Kullanıcıya gösterilecek kaynak etiketi (Örn: FDA Prospektüsü)
  verificationStatus Status   @default(VERIFIED)
  evidenceLevel      EvidenceLevel @default(FDA_APPROVED) // Klinik Kanıt Seviyesi
  createdAt          DateTime @default(now())
  
  drug1              Drug     @relation("Drug1Relation", fields: [drug1Id], references: [id], onDelete: Cascade)
  drug2              Drug     @relation("Drug2Relation", fields: [drug2Id], references: [id], onDelete: Cascade)
  evidences          InteractionEvidence[]
  mechanisms         InteractionMechanism[]

  @@unique([drug1Id, drug2Id])
  @@index([drug1Id])
  @@index([drug2Id])
}

model FoodInteraction {
  id          String   @id @default(uuid())
  drugId      String
  substance   String   // Örn: Greyfurt Suyu, Alkol, Kafein
  effect      String   @db.Text // Türkçe klinik etki açıklaması
  severity    Severity
  drug        Drug     @relation(fields: [drugId], references: [id], onDelete: Cascade)
}

model Contraindication {
  id          String   @id @default(uuid())
  drugId      String
  diseaseIcd  String   // ICD-10 Kodu (Örn: K25 - Peptik Ülser)
  diseaseName String   // Hastalık Adı (Türkçe)
  severity    Severity
  drug        Drug     @relation(fields: [drugId], references: [id], onDelete: Cascade)
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  createdAt      DateTime       @default(now())
  savedPillboxes SavedPillbox[]
  clinicalReviews ClinicalReview[]
}

model SavedPillbox {
  id        String   @id @default(uuid())
  userId    String
  name      String   // Örn: "Sabah İlaçlarım"
  drugIds   String[] // İlaç ID listesi
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EvidenceSource {
  id          String   @id @default(uuid())
  title       String
  url         String   @unique
  sourceType  String
  publisher   String?
  publishedAt DateTime?
  retrievedAt DateTime
  version     String?
  licenseType String?
  
  evidences   InteractionEvidence[]
  reviews     ClinicalReview[]
}

model InteractionEvidence {
  id            String          @id @default(uuid())
  interactionId String
  sourceId      String
  evidenceLevel EvidenceLevel   @default(FDA_APPROVED)
  summary       String          @db.Text
  quote         String?         @db.Text
  confidence    Float?
  reviewStatus  Status          @default(VERIFIED)
  
  interaction   DrugInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  source        EvidenceSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([interactionId])
  @@index([sourceId])
}

model ClinicalReview {
  id               String          @id @default(uuid())
  entityType       String
  entityId         String
  reviewerRole     String
  reviewerId       String?
  decision         String
  notes            String?         @db.Text
  reviewedAt       DateTime        @default(now())
  evidenceSourceId String?
  
  reviewer         User?           @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  evidenceSource   EvidenceSource? @relation(fields: [evidenceSourceId], references: [id], onDelete: SetNull)

  @@index([entityId])
  @@index([reviewerId])
  @@index([evidenceSourceId])
}

model Ingredient {
  id               String      @id @default(uuid())
  name             String      @unique
  normalizedName   String      @unique
  rxcui            String?     @unique
  atcCode          String?     @unique
  
  drugs            Drug[]
  drugAliases      DrugAlias[]
}

model DrugAlias {
  id              String      @id @default(uuid())
  drugId          String
  alias           String
  normalizedAlias String
  aliasType       String
  locale          String      @default("tr")
  ingredientId    String?
  
  drug            Drug        @relation(fields: [drugId], references: [id], onDelete: Cascade)
  ingredient      Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@unique([drugId, normalizedAlias])
  @@index([normalizedAlias])
  @@index([drugId])
  @@index([ingredientId])
}

model DrugClass {
  id        String      @id @default(uuid())
  name      String
  code      String      @unique
  system    String
  parentId  String?
  
  parent    DrugClass?  @relation("DrugClassHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  DrugClass[] @relation("DrugClassHierarchy")
  drugs     Drug[]

  @@index([parentId])
}

model InteractionMechanism {
  id            String          @id @default(uuid())
  interactionId String
  type          String
  mechanism     String          @db.Text
  pharmacokinetic Boolean       @default(false)
  pharmacodynamic Boolean       @default(false)
  
  interaction   DrugInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([interactionId])
}

model PillboxShare {
  id        String   @id @default(uuid())
  token     String   @unique
  drugIds   String[]
  summary   String?  @db.Text // JSON or text summary of risks
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  eventType String   // E.g., "CLINICAL_REVIEW_UPDATE", "SHARE_CREATED"
  entityType String  // E.g., "ClinicalReview", "PillboxShare"
  entityId   String?
  userId     String?
  details    String?  @db.Text // Masked/redacted GDPR details
  createdAt  DateTime @default(now())
}

